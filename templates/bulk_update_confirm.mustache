{{!
    @template block_blc_modules/bulk_update_confirm

    Bulk Update confirmation modal.

    Context variables:
    * sesskey - String, session key
    * wwwroot - String, Moodle wwwroot URL
}}

<div class="modal fade" id="modalForm" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel">{{#str}}updatescormconfirm, block_blc_modules{{/str}}</h4>
            </div>
            <div class="modal-body">
                <p class="statusMsg">{{#str}}updateconfirmmessage, block_blc_modules{{/str}}</p>
                <form role="form" action="{{wwwroot}}/blocks/blc_modules/bulk_update.php"
                    id="bulkupdatesubmit" method="post">
                    <input type="hidden" name="action" value="continue"/>
                    <input type="hidden" name="sesskey" value="{{sesskey}}"/>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}}cancel{{/str}}</button>
                <button type="button" class="btn btn-primary" id="bulkupdatecont">{{#str}}continue{{/str}}</button>
            </div>
        </div>
    </div>
</div>